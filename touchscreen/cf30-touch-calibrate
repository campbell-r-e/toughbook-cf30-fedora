#!/usr/bin/env python3
"""
cf30-touch-calibrate — calibrate the Panasonic CF-30 resistive touch panel.

The panel is a "Fujitsu Component USB Touch Panel" (USB 0430:0530). Under a
Wayland compositor (this machine runs Mir/miriway) there is no interactive
calibrator, so calibration is a libinput calibration matrix installed as a udev
rule. This tool captures four corner touches, fits the affine matrix that maps
the raw panel coordinates onto the screen, writes the rule, and re-adds the
device so the result takes effect immediately — no reboot.

Usage (run at the laptop, not over SSH — you have to touch the screen):

    sudo cf30-touch-calibrate            # run the 4-corner calibration
    sudo cf30-touch-calibrate --show     # print the current matrix
    sudo cf30-touch-calibrate --reset    # remove calibration (identity)

It grabs the panel during calibration so stray touches don't click things.
"""
import fcntl
import os
import struct
import sys
import time

DEVICE_NAME = "Fujitsu Component USB Touch Panel"
VENDOR = "0430"
PRODUCT = "0530"
RULE = "/etc/udev/rules.d/73-cf30-touch-calibration.rules"
DAEMON = "cf30-touch-mouse.service"   # holds an exclusive grab on the panel

# --- evdev constants ---
EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03
ABS_X, ABS_Y = 0x00, 0x01
BTN_TOUCH = 0x14a

EVENT_FMT = "llHHi"          # timeval(2*long) + type + code + value  (x86-64: 24 bytes)
EVENT_SIZE = struct.calcsize(EVENT_FMT)


def _IOR(t, nr, size):
    return (2 << 30) | (size << 16) | (t << 8) | nr


def _IOW(t, nr, size):
    return (1 << 30) | (size << 16) | (t << 8) | nr


def EVIOCGABS(axis):
    return _IOR(ord('E'), 0x40 + axis, 24)      # struct input_absinfo = 6*int32


EVIOCGRAB = _IOW(ord('E'), 0x90, 4)


def find_event_node():
    base = "/sys/class/input"
    for entry in sorted(os.listdir(base)):
        if not entry.startswith("event"):
            continue
        try:
            with open(os.path.join(base, entry, "device", "name")) as f:
                if f.read().strip() == DEVICE_NAME:
                    return "/dev/input/" + entry
        except OSError:
            continue
    return None


def abs_range(fd, axis):
    buf = bytearray(24)
    try:
        fcntl.ioctl(fd, EVIOCGABS(axis), buf, True)
        value, minimum, maximum, fuzz, flat, res = struct.unpack("6i", buf)
        if maximum > minimum:
            return minimum, maximum
    except OSError:
        pass
    return 0, 4096                                # sane default for this panel


def median(vals):
    s = sorted(vals)
    n = len(s)
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def capture_one_touch(fd):
    """Block until the user presses and releases; return (median_x, median_y)."""
    xs, ys = [], []
    touching = False
    cur_x = cur_y = None
    while True:
        data = os.read(fd, EVENT_SIZE * 32)
        for i in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
            _, _, etype, code, value = struct.unpack(EVENT_FMT, data[i:i + EVENT_SIZE])
            if etype == EV_ABS and code == ABS_X:
                cur_x = value
            elif etype == EV_ABS and code == ABS_Y:
                cur_y = value
            elif etype == EV_KEY and code == BTN_TOUCH:
                touching = value == 1
                if not touching and xs:
                    return median(xs), median(ys)
            elif etype == EV_SYN:
                if touching and cur_x is not None and cur_y is not None:
                    xs.append(cur_x)
                    ys.append(cur_y)


def solve3(A, b):
    """Solve the 3x3 system A x = b by Gaussian elimination with partial pivot."""
    M = [row[:] + [b[i]] for i, row in enumerate(A)]
    for col in range(3):
        piv = max(range(col, 3), key=lambda r: abs(M[r][col]))
        if abs(M[piv][col]) < 1e-12:
            raise ValueError("degenerate calibration (touches too close / collinear)")
        M[col], M[piv] = M[piv], M[col]
        pivval = M[col][col]
        M[col] = [v / pivval for v in M[col]]
        for r in range(3):
            if r != col:
                factor = M[r][col]
                M[r] = [a - factor * b_ for a, b_ in zip(M[r], M[col])]
    return [M[0][3], M[1][3], M[2][3]]


def fit_affine(raw_norm, ideal):
    """Least-squares affine fit: coeffs for sx and sy from rows [u, v, 1]."""
    # Normal equations A^T A p = A^T s, with A rows = [u, v, 1]
    AtA = [[0.0] * 3 for _ in range(3)]
    Atx = [0.0] * 3
    Aty = [0.0] * 3
    for (u, v), (sx, sy) in zip(raw_norm, ideal):
        row = [u, v, 1.0]
        for i in range(3):
            for j in range(3):
                AtA[i][j] += row[i] * row[j]
            Atx[i] += row[i] * sx
            Aty[i] += row[i] * sy
    a, b, c = solve3([r[:] for r in AtA], Atx)
    d, e, f = solve3([r[:] for r in AtA], Aty)
    return a, b, c, d, e, f


def write_rule(matrix):
    m = " ".join("%.6f" % v for v in matrix)
    text = (
        "# Calibration matrix for the CF-30 Fujitsu resistive touch panel.\n"
        "# Generated by cf30-touch-calibrate. Re-run that tool to change it.\n"
        'ACTION=="add|change", KERNEL=="event*", '
        'ENV{ID_VENDOR_ID}=="%s", ENV{ID_MODEL_ID}=="%s", '
        'ENV{LIBINPUT_CALIBRATION_MATRIX}="%s"\n' % (VENDOR, PRODUCT, m)
    )
    with open(RULE, "w") as f:
        f.write(text)
    return m


def daemon_active():
    return os.system("systemctl is-active --quiet %s" % DAEMON) == 0



def find_usb_interface():
    base = "/sys/bus/usb/devices"
    for dev in os.listdir(base):
        p = os.path.join(base, dev)
        try:
            with open(os.path.join(p, "idVendor")) as f:
                if f.read().strip() != VENDOR:
                    continue
            with open(os.path.join(p, "idProduct")) as f:
                if f.read().strip() != PRODUCT:
                    continue
        except OSError:
            continue
        for entry in os.listdir(p):
            if entry.startswith(dev + ":"):
                return entry
    return None


def apply_now():
    os.system("udevadm control --reload")
    iface = find_usb_interface()
    drv = "/sys/bus/usb/drivers/usbhid"
    if iface and os.path.exists(os.path.join(drv, iface)):
        try:
            with open(os.path.join(drv, "unbind"), "w") as f:
                f.write(iface)
            time.sleep(1)
            with open(os.path.join(drv, "bind"), "w") as f:
                f.write(iface)
            time.sleep(2)
            return True
        except OSError:
            pass
    os.system("udevadm trigger --subsystem-match=input --attr-match=idVendor=%s" % VENDOR)
    return False


def show():
    os.system(
        "libinput list-devices 2>/dev/null | "
        "awk 'BEGIN{RS=\"\"} /Fujitsu/' | grep -E 'Device|Kernel|Capabilities|Calibration'"
    )
    if os.path.exists(RULE):
        print("\nRule: %s" % RULE)
        with open(RULE) as f:
            for line in f:
                if line.startswith("ACTION"):
                    print("  " + line.strip())
    else:
        print("\nNo calibration rule installed (identity).")


def reset():
    resume = daemon_active()
    if resume:
        os.system("systemctl stop %s" % DAEMON)
        time.sleep(0.5)
    if os.path.exists(RULE):
        os.remove(RULE)
        print("Removed %s" % RULE)
    else:
        print("No calibration rule to remove.")
    if resume:
        os.system("systemctl start %s" % DAEMON)   # reloads identity matrix
    else:
        apply_now()
    print("Reset to identity.")


def calibrate():
    node = find_event_node()
    if not node:
        sys.exit("Could not find '%s' — is the panel connected?" % DEVICE_NAME)

    # The touch-mouse daemon holds an exclusive grab on the panel; stop it while
    # we read raw touches, then bring it back so it picks up the new matrix.
    resume_daemon = daemon_active()
    if resume_daemon:
        os.system("systemctl stop %s" % DAEMON)
        time.sleep(0.5)

    try:
        fd = os.open(node, os.O_RDONLY)
        xmin, xmax = abs_range(fd, ABS_X)
        ymin, ymax = abs_range(fd, ABS_Y)

        print("CF-30 touch calibration")
        print("Panel: %s  (%s)" % (DEVICE_NAME, node))
        print("Touch each target as close to the corner as you can, hold ~1s, release.\n")

        try:
            fcntl.ioctl(fd, EVIOCGRAB, struct.pack("i", 1))   # grab so touches don't leak
        except OSError:
            pass

        corners = [
            ("TOP-LEFT",     (0.0, 0.0)),
            ("TOP-RIGHT",    (1.0, 0.0)),
            ("BOTTOM-RIGHT", (1.0, 1.0)),
            ("BOTTOM-LEFT",  (0.0, 1.0)),
        ]
        raw_norm, ideal = [], []
        try:
            for name, target in corners:
                print(">>> Touch the %s corner ..." % name, flush=True)
                x, y = capture_one_touch(fd)
                u = (x - xmin) / float(xmax - xmin)
                v = (y - ymin) / float(ymax - ymin)
                raw_norm.append((u, v))
                ideal.append(target)
                print("    got raw (%d, %d)\n" % (x, y), flush=True)
                time.sleep(0.4)
        finally:
            try:
                fcntl.ioctl(fd, EVIOCGRAB, struct.pack("i", 0))
            except OSError:
                pass
            os.close(fd)

        matrix = fit_affine(raw_norm, ideal)
        m = write_rule(matrix)
        print("Calibration matrix: %s" % m)
        print("Rule written to %s" % RULE)
        if not resume_daemon:
            applied = apply_now()
            print("Applied immediately." if applied
                  else "Applied via udev trigger (replug or reboot if needed).")
        print("\nTest by touching around the screen — the cursor should land under your finger.")
        print("Not right? Just run this again. To undo: sudo cf30-touch-calibrate --reset")
    finally:
        # Always bring the daemon back, even if calibration was interrupted.
        if resume_daemon:
            os.system("systemctl start %s" % DAEMON)   # daemon reloads the matrix


def main():
    if os.geteuid() != 0:
        sys.exit("Run as root:  sudo cf30-touch-calibrate")
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("--show", "-s"):
        show()
    elif arg in ("--reset", "-r"):
        reset()
    elif arg in ("", "--calibrate", "-c"):
        calibrate()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
